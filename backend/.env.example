# Application
APP_NAME="Media Generation Platform"
APP_VERSION="0.1.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=true
LOG_LEVEL="info"  # debug, info, warning, error, critical

# API
API_HOST="0.0.0.0"
API_PORT=8000
API_SECRET_KEY="your-secret-key-change-this-in-production"
API_RATE_LIMIT=100  # requests per minute per IP

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/media_generation"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false  # Set to true for SQL query logging

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_MAX_CONNECTIONS=50

# Celery
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"
CELERY_TASK_ALWAYS_EAGER=false  # Set to true for synchronous testing

# Storage (S3/MinIO)
S3_ENDPOINT_URL="http://localhost:9000"  # MinIO for local dev
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="media-generation"
S3_REGION="us-east-1"
USE_SSL=false  # Set to true for production

# CDN (Optional)
CDN_URL=""  # CloudFront or Cloudflare URL

# AI Models
HUNYUAN_MODEL_PATH="/models/hunyuan"
MONEYPRINTER_PATH="/models/moneyprinter"
MODEL_CACHE_DIR="/tmp/model_cache"

# Content Generation
MAX_IMAGE_SIZE=2048  # pixels
MAX_VIDEO_DURATION=300  # seconds
DEFAULT_IMAGE_FORMAT="png"
DEFAULT_VIDEO_FORMAT="mp4"

# Video Generation Settings
VIDEO_RESOLUTION_WIDTH=1080  # Portrait: 1080, Landscape: 1920
VIDEO_RESOLUTION_HEIGHT=1920  # Portrait: 1920, Landscape: 1080
VIDEO_FPS=30  # Frames per second
VIDEO_BITRATE="5000k"  # Video bitrate (higher = better quality, larger file)
VIDEO_CODEC="libx264"  # Video codec (libx264, h264_nvenc for GPU)
AUDIO_CODEC="aac"  # Audio codec

# Text-to-Speech Settings
TTS_PROVIDER="edge"  # Options: edge (free), openai (paid)
TTS_VOICE="en-US-AriaNeural"  # Edge TTS voice (use 'edge-tts --list-voices' to see all)
TTS_RATE="+0%"  # Speech rate: -50% to +100%
TTS_VOLUME="+0%"  # Volume: -50% to +50%

# LLM Provider Settings (for script generation)
LLM_PROVIDER="ollama"  # Options: ollama (local, free) or openai (cloud, paid)

# Ollama Settings (local LLM - recommended)
OLLAMA_BASE_URL="http://localhost:11434"  # Ollama API endpoint
OLLAMA_MODEL="llama3.2"  # Model name (llama3.2, mistral, deepseek-r1, etc.)
OLLAMA_TEMPERATURE=0.7  # Creativity level (0.0-2.0)
OLLAMA_MAX_TOKENS=2000  # Maximum tokens for script generation

# OpenAI Settings (alternative LLM provider)
OPENAI_API_KEY=""  # Your OpenAI API key (only needed if LLM_PROVIDER=openai)
OPENAI_MODEL="gpt-4o-mini"  # Model for script generation
OPENAI_TEMPERATURE=0.7  # Creativity level (0.0-2.0)
OPENAI_MAX_TOKENS=2000  # Maximum tokens for script generation

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_ALLOW_HEADERS="*"

# Monitoring & Observability
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
OTEL_ENABLED=false  # OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_SERVICE_NAME="media-gen-api"

# Security
NSFW_DETECTION_ENABLED=true
NSFW_THRESHOLD=0.7
CONTENT_MODERATION_ENABLED=true

# Webhooks
WEBHOOK_TIMEOUT=30  # seconds
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=60  # seconds

# Background Tasks
TASK_TIMEOUT=3600  # seconds (1 hour)
TASK_MAX_RETRIES=3
TASK_RETRY_DELAY=300  # seconds (5 minutes)

# Development
RELOAD=true  # Auto-reload on code changes
WORKERS=1  # Number of Uvicorn workers (set to CPU count in production)

# Testing
TEST_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/media_generation_test"

